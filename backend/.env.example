# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Placeholder - use local or your own Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# Authentication secrets (use different random values of at least 32 characters)
JWT_ACCESS_SECRET=placeholder_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=placeholder_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Private local resume storage (use a managed private object-storage adapter in production)
RESUME_STORAGE_DIR=./private-uploads/resumes
# Use gridfs on hosts with ephemeral filesystems; stores private PDFs in MongoDB.
RESUME_STORAGE_PROVIDER=local

# Used only by `npm run bootstrap:admin`; do not persist real values in source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=HireFlow Administrator

# Email: Render blueprint uses Resend over HTTPS; SMTP remains supported.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
# Use a verified sender. For SMTP, choose a host that allows outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Production always requires verified email; enable this to test verification locally.
REQUIRE_EMAIL_VERIFICATION=false
